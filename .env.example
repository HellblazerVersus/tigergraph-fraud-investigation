TIGERGRAPH_HOST=localhost
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH=fraud_investigation
TIGERGRAPH_PORT=9000
TIGERGRAPH_USE_SSL=false

GEMINI_API_KEY=your-gemini-api-key-here

# Models
REASONING_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# Paths
DATASET_DIR=./HHGOA_IEEE
CASES_OUTPUT_DIR=./cases

# Agent tuning
MAX_INVESTIGATION_ITERATIONS=8
FRAUD_PROB_HIGH_THRESHOLD=0.85
FRAUD_PROB_LOW_THRESHOLD=0.15
FRAUD_PROB_UNCERTAIN_THRESHOLD=0.70
