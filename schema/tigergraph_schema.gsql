// ============================================================
// TigerGraph Schema — HHGOA Fraud Investigation
// Version: 1.0
// ============================================================

// ========================
// VERTICES
// ========================

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING,
  created_at DATETIME
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  customer_id STRING,
  card1 INT,
  card2 FLOAT,
  card3 FLOAT,
  card4 STRING,
  card5 FLOAT,
  card6 STRING,
  status STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX Transaction (
  PRIMARY_ID txn_id STRING,
  card_id STRING,
  customer_id STRING,
  ts DATETIME,
  transaction_dt INT,
  amount FLOAT,
  product_cd STRING,
  channel STRING,
  addr1 FLOAT,
  addr2 FLOAT,
  dist1 FLOAT,
  dist2 FLOAT,
  p_emaildomain STRING,
  r_emaildomain STRING,
  risk_score FLOAT
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_profile_id STRING,
  device_info STRING,
  device_type STRING,
  os STRING,
  browser STRING,
  screen STRING,
  is_new_device STRING,
  proxy_type STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX BillingRegion (
  PRIMARY_ID region_code STRING,
  country_code FLOAT
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,
  pattern STRING,
  first_fraud_txn_id STRING,
  n_txns INT,
  exposure_usd FLOAT,
  actions_taken STRING,
  report_filed BOOL,
  analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX FraudCase (
  PRIMARY_ID case_id STRING,
  source_case_pack_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  status STRING,
  verdict STRING,
  fraud_probability FLOAT,
  pattern STRING,
  pattern_description STRING,
  first_suspicious_txn_id STRING,
  exposure_usd FLOAT,
  summary STRING,
  stop_reason STRING,
  written_to_graph BOOL
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX PolicyDocument (
  PRIMARY_ID doc_id STRING,
  title STRING,
  content STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX FraudPattern (
  PRIMARY_ID pattern_id STRING,
  name STRING,
  description STRING,
  policy_rules STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

// ========================
// EDGES
// ========================

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card)
  WITH REVERSE_EDGE="OWNED_BY"

CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction)
  WITH REVERSE_EDGE="MADE_BY"

CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile)
  WITH REVERSE_EDGE="DEVICE_USED_IN"

CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)

CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion)

CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction,
  days_gap FLOAT
)

CREATE DIRECTED EDGE CC_INVOLVES (FROM ClosedCase, TO Transaction)
CREATE DIRECTED EDGE CC_ON_CARD (FROM ClosedCase, TO Card)
CREATE DIRECTED EDGE CC_CONNECTED_CARD (FROM ClosedCase, TO Card)

CREATE DIRECTED EDGE CASE_INVOLVES (FROM FraudCase, TO Transaction)
CREATE DIRECTED EDGE CASE_ON_CARD (FROM FraudCase, TO Card)
CREATE DIRECTED EDGE CASE_CONNECTED_CARD (FROM FraudCase, TO Card)
CREATE DIRECTED EDGE CASE_MATCHES_PATTERN (FROM FraudCase, TO FraudPattern)

CREATE UNDIRECTED EDGE SHARED_DEVICE (FROM Card, TO Card,
  device_profile_id STRING,
  window_days INT
)

CREATE UNDIRECTED EDGE SHARED_REGION (FROM Card, TO Card,
  region_code STRING,
  window_days INT
)

// ========================
// GRAPH
// ========================

CREATE GRAPH fraud_investigation (
  Customer, Card, Transaction, DeviceProfile,
  EmailDomain, BillingRegion,
  ClosedCase, FraudCase,
  PolicyDocument, FraudPattern,
  OWNS, OWNED_BY,
  MADE, MADE_BY,
  FROM_DEVICE, DEVICE_USED_IN,
  PURCHASER_EMAIL, BILLED_IN,
  NEXT_TXN,
  CC_INVOLVES, CC_ON_CARD, CC_CONNECTED_CARD,
  CASE_INVOLVES, CASE_ON_CARD, CASE_CONNECTED_CARD,
  CASE_MATCHES_PATTERN,
  SHARED_DEVICE, SHARED_REGION
)
